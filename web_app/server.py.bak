                        "query": {
                            "type": "STRING",
                            "description": "The person name, phone digits, or search term (e.g. 'rohit', '9876543210')"
                        },
                        "status": {
                            "type": "STRING",
                            "description": "Optional filter by client status ('New Lead', 'Follow-up', 'Interested')"
                        }
                    }
                }
            },
            {
                "name": "get_crm_vault_summary",
                "description": "Returns the exact live count and stats of the Client Vault (total clients, new leads count, follow-ups due, interested).",
                "parameters": {
                    "type": "OBJECT",
                    "properties": {}
                }
            },
            {
                "name": "get_recent_clients",
                "description": "Returns the most recently added or updated clients in the CRM vault.",
                "parameters": {
                    "type": "OBJECT",
                    "properties": {
                        "limit": {
                            "type": "INTEGER",
                            "description": "Number of recent clients to return (default: 5)"
                        }
                    }
                }
            },
            {
                "name": "add_staff_member",
                "description": "Adds or registers a brand new employee or staff member in the Staff Directory (users_vault.json). ALWAYS call this tool when the user asks to add staff, employee, or team member (e.g. 'mere liye ek naya staff add kar do staff ka naam mohan hai aur phone number 1234567890', 'add new staff Sachin').",
                "parameters": {
                    "type": "OBJECT",
                    "properties": {
                        "name": {
                            "type": "STRING",
                            "description": "Full name of the staff member (e.g. 'Mohan', 'Rahul Sharma')"
                        },
                        "phone": {
                            "type": "STRING",
                            "description": "Contact phone number (e.g. '1234567890', '9876543210')"
                        },
                        "role": {
                            "type": "STRING",
                            "description": "Staff role or designation in professional English (e.g. 'Staff Member', 'Sales Executive', 'Accountant', 'Developer')"
                        },
                        "monthly_salary": {
                            "type": "NUMBER",
                            "description": "Monthly salary amount in INR (optional, default 0)"
                        },
                        "email": {
                            "type": "STRING",
                            "description": "Email address (optional)"
                        }
                    },
                    "required": ["name"]
                }
            },
            {
                "name": "delete_staff_member",
                "description": "Deletes or removes an employee or staff member from the Staff Directory (users_vault.json).",
                "parameters": {
                    "type": "OBJECT",
                    "properties": {
                        "name_or_username": {
                            "type": "STRING",
                            "description": "Name or username of the staff member to remove (e.g. 'Mohan', 'rohit')"
                        }
                    },
                    "required": ["name_or_username"]
                }
            },
            {
                "name": "create_invoice",
                "description": "Generates and records a new client Invoice or Quotation in the Invoices Vault (invoices_vault.json).",
                "parameters": {
                    "type": "OBJECT",
                    "properties": {
                        "client_name": {
                            "type": "STRING",
                            "description": "Name of the client/customer"
                        },
                        "amount": {
                            "type": "NUMBER",
                            "description": "Monetary invoice amount in INR"
                        },
                        "type": {
                            "type": "STRING",
                            "description": "Type: 'Invoice' (default) or 'Quotation'"
                        },
                        "status": {
                            "type": "STRING",
                            "description": "Payment status: 'Pending' (default) or 'Paid'"
                        },
                        "description": {
                            "type": "STRING",
                            "description": "Professional English description of services or products"
                        }
                    },
                    "required": ["client_name", "amount"]
                }
            },
            {
                "name": "add_reminder",
                "description": "Creates a business reminder or alert in the Reminders Vault (reminders_vault.json).",
                "parameters": {
                    "type": "OBJECT",
                    "properties": {
                        "title": {
                            "type": "STRING",
                            "description": "Reminder text or note in professional English (e.g. 'Follow up with Nikhil for project milestone')"
                        },
                        "date": {
                            "type": "STRING",
                            "description": "Date or timeframe (e.g. 'Today', 'Tomorrow', '2026-11-20')"
                        },
                        "time": {
                            "type": "STRING",
                            "description": "Time of reminder (e.g. '11:00 AM')"
                        }
                    },
                    "required": ["title"]
                }
            },
            {
                "name": "toggle_reminder",
                "description": "Toggles, completes, or checks off a reminder.",
                "parameters": {
                    "type": "OBJECT",
                    "properties": {
                        "reminder_query": {
                            "type": "STRING",
                            "description": "Title keyword or ID of the reminder"
                        }
                    },
                    "required": ["reminder_query"]
                }
            },
            {
                "name": "record_attendance",
                "description": "Records or punches daily staff attendance in the Attendance Vault (attendance_vault.json).",
                "parameters": {
                    "type": "OBJECT",
                    "properties": {
                        "staff_name": {
                            "type": "STRING",
                            "description": "Name of the employee"
                        },
                        "status": {
                            "type": "STRING",
                            "description": "Attendance status: 'Present', 'Absent', or 'Half Day'"
                        },
                        "date": {
                            "type": "STRING",
                            "description": "Date (e.g. 'Today', '2026-11-17')"
                        }
                    },
                    "required": ["staff_name", "status"]
                }
            },
            {
                "name": "create_ticket",
                "description": "Creates a new customer support ticket in the Tickets Vault (tickets_vault.json).",
                "parameters": {
                    "type": "OBJECT",
                    "properties": {
                        "customer_name": {
                            "type": "STRING",
                            "description": "Customer or client name reporting the issue"
                        },
                        "subject": {
                            "type": "STRING",
                            "description": "Subject or summary of the issue in professional English"
                        },
                        "priority": {
                            "type": "STRING",
                            "description": "Priority: 'High', 'Normal', or 'Low'"
                        }
                    },
                    "required": ["customer_name", "subject"]
                }
            },
            {
                "name": "update_ticket_status",
                "description": "Updates or resolves a customer support ticket status.",
                "parameters": {
                    "type": "OBJECT",
                    "properties": {
                        "ticket_query": {
                            "type": "STRING",
                            "description": "Ticket ID (e.g. 'TCK-1001') or customer name / subject keyword"
                        },
                        "new_status": {
                            "type": "STRING",
                            "description": "Status: 'Resolved', 'In Progress', 'Closed', or 'Open'"
                        }
                    },
                    "required": ["ticket_query", "new_status"]
                }
            }
        ]
    }
]

def resolve_gemini_tool_call(func_name, func_args):
    clients = []
    if os.path.exists(CLIENTS_VAULT_PATH):
        try:
            with open(CLIENTS_VAULT_PATH, "r", encoding="utf-8") as f:
                clients = json.load(f)
        except:
            clients = []

    tasks = []
    if os.path.exists(TASKS_VAULT_PATH):
        try:
            with open(TASKS_VAULT_PATH, "r", encoding="utf-8") as f:
                tasks = json.load(f)
        except:
            tasks = []

    if func_name == "record_financial_transaction":
        raw_amt = func_args.get("amount", 0)
        try:
            amt = float(raw_amt)
        except:
            amt = 0.0

        party = str(func_args.get("party") or "").strip().title()
        txn_type = str(func_args.get("type") or "Expense").strip().title()
        if txn_type not in ["Income", "Expense"]:
            txn_type = "Expense"

        title = str(func_args.get("title") or f"{txn_type} transaction").strip()
        category = str(func_args.get("category") or ("Staff Payments" if party else "General")).strip()
        payment_mode = str(func_args.get("payment_mode") or "UPI").strip().upper()

        acc_path = os.path.join(DATA_DIR, "accounts_vault.json")
        txns = []
        if os.path.exists(acc_path):
            try:
                with open(acc_path, "r", encoding="utf-8") as f:
                    txns = json.load(f)
            except:
                txns = []

        new_txn = {
            "id": f"TXN-{int(time.time()) % 10000}",
            "title": title,
            "type": txn_type,
            "category": category,
            "amount": amt,
            "date": datetime.now().strftime("%Y-%m-%d"),
            "payment_mode": payment_mode,
            "party": party,
            "status": "Paid" if txn_type == "Expense" else "Received",
            "notes": f"Recorded by Achyuta AI at {datetime.now().strftime('%H:%M:%S')}"
        }

        with file_lock:
            txns.insert(0, new_txn)
            try:
                with open(acc_path, "w", encoding="utf-8") as f:
                    json.dump(txns, f, ensure_ascii=False, indent=2)
            except Exception as e:
                pass

        return {
            "success": True,
            "action_executed": True,
            "action_type": "record_financial_transaction",
            "transaction_id": new_txn["id"],
            "amount": amt,
            "party": party,
            "type": txn_type,
            "title": title,
            "category": category,
            "date": new_txn["date"],
            "payment_mode": payment_mode,
            "message": f"Successfully recorded {txn_type} of ₹{amt:,.2f} for '{party or title}' in the Accounts Ledger."
        }

    elif func_name == "delete_financial_transaction":
        raw_amt = func_args.get("amount")
        target_amt = None
        if raw_amt is not None:
            try:
                target_amt = float(raw_amt)
            except:
                pass

        title_party = str(func_args.get("title_or_party") or "").strip().lower()
        txn_id = str(func_args.get("transaction_id") or "").strip().upper()

        acc_path = os.path.join(DATA_DIR, "accounts_vault.json")
        txns = []
        if os.path.exists(acc_path):
            try:
                with open(acc_path, "r", encoding="utf-8") as f:
                    txns = json.load(f)
            except:
                txns = []

        deleted_txn = None
        if txn_id == "ALL":
            orig_count = len(txns)
            txns = []
            with file_lock:
                try:
                    with open(acc_path, "w", encoding="utf-8") as f:
                        json.dump(txns, f, ensure_ascii=False, indent=2)
                except:
                    pass
            return {
                "success": True,
                "action_executed": True,
                "action_type": "delete_financial_transaction",
                "deleted_count": orig_count,
                "message": f"Successfully cleared all {orig_count} transactions from Accounts Ledger."
            }

        # Find best matching transaction
        match_idx = -1
        for idx, t in enumerate(txns):
            t_id = str(t.get("id") or "").upper()
            t_amt = float(t.get("amount") or 0)
            t_title = str(t.get("title") or "").lower()
            t_party = str(t.get("party") or "").lower()

            if txn_id and txn_id == t_id:
                match_idx = idx
                break
            
            # Check by amount and title/party
            amt_matches = (target_amt is not None and abs(t_amt - target_amt) < 0.01)
            text_matches = bool(title_party and (title_party in t_title or title_party in t_party))

            if amt_matches and text_matches:
                match_idx = idx
                break
            elif amt_matches and not title_party:
                match_idx = idx
                break
            elif text_matches and target_amt is None:
                match_idx = idx
                break

        if match_idx >= 0:
            deleted_txn = txns.pop(match_idx)
            with file_lock:
                try:
                    with open(acc_path, "w", encoding="utf-8") as f:
                        json.dump(txns, f, ensure_ascii=False, indent=2)
                except:
                    pass
            return {
                "success": True,
                "action_executed": True,
                "action_type": "delete_financial_transaction",
                "deleted_transaction": deleted_txn,
                "message": f"Successfully deleted transaction '{deleted_txn.get('title')}' of ₹{deleted_txn.get('amount'):,.2f} from Accounts Ledger."
            }
        else:
            return {
                "success": False,
                "action_executed": False,
                "error": f"No matching transaction found in Accounts Ledger for amount {target_amt} / {title_party}."
            }

    elif func_name == "pay_staff_salary":
        raw_amt = func_args.get("amount", 0)
        try:
            amt = float(raw_amt)
        except:
            amt = 0.0

        staff_name = str(func_args.get("staff_name") or "Staff").strip().title()
        month = str(func_args.get("month") or datetime.now().strftime("%B %Y")).strip()
        mode = str(func_args.get("payment_mode") or "UPI").strip().upper()

        sal_path = os.path.join(DATA_DIR, "salary_vault.json")
        salaries = []
        if os.path.exists(sal_path):
            try:
                with open(sal_path, "r", encoding="utf-8") as f:
                    salaries = json.load(f)
            except:
                salaries = []

        new_sal = {
            "id": f"SAL-{int(time.time()) % 10000}",
            "staff_name": staff_name,
            "role": "Team Member",
            "month": month,
            "base_salary": amt,
            "bonus": 0.0,
            "deductions": 0.0,
            "net_amount": amt,
            "payment_mode": mode,
            "status": "Paid",
            "date": datetime.now().strftime("%Y-%m-%d"),
            "remarks": f"Disbursed via Achyuta Agent on {datetime.now().strftime('%d %b %Y')}"
        }

        with file_lock:
            salaries.insert(0, new_sal)
            try:
                with open(sal_path, "w", encoding="utf-8") as f:
                    json.dump(salaries, f, ensure_ascii=False, indent=2)
            except:
                pass

        return {
            "success": True,
            "action_executed": True,
            "action_type": "pay_staff_salary",
            "staff_name": staff_name,
            "amount": amt,
            "month": month,
            "message": f"Salary disbursement of ₹{amt:,.2f} recorded for {staff_name} ({month})."
        }

    elif func_name == "update_salary_record":
        staff_target = str(func_args.get("staff_name") or "").strip().lower()
        raw_amt = func_args.get("new_amount", 0)
        try:
            new_amt = float(raw_amt)
        except:
            new_amt = 0.0

        month_target = str(func_args.get("month") or "").strip().lower()
        new_status = func_args.get("status")

        sal_path = os.path.join(DATA_DIR, "salary_vault.json")
        salaries = []
        if os.path.exists(sal_path):
            try:
                with open(sal_path, "r", encoding="utf-8") as f:
                    salaries = json.load(f)
            except:
                salaries = []

        updated_sal = None
        old_amt = 0.0
        for s in salaries:
            s_name = str(s.get("staff_name") or "").lower()
            s_month = str(s.get("month") or "").lower()
            if staff_target in s_name or (not staff_target and len(salaries) == 1):
                if month_target and month_target not in s_month and "last" not in month_target:
                    continue
                old_amt = float(s.get("net_amount") or s.get("base_salary") or 0.0)
                s["base_salary"] = new_amt
                s["net_amount"] = new_amt
                if new_status:
                    s["status"] = new_status
                s["notes"] = f"Corrected by AI Agent from ₹{old_amt:,.0f} to ₹{new_amt:,.0f}"
                updated_sal = s
                break

        if updated_sal:
            with file_lock:
                try:
                    with open(sal_path, "w", encoding="utf-8") as f:
                        json.dump(salaries, f, ensure_ascii=False, indent=2)
                except:
                    pass

            return {
                "success": True,
                "action_executed": True,
                "action_type": "update_salary_record",
                "staff_name": updated_sal.get("staff_name"),
                "month": updated_sal.get("month"),
                "previous_amount": old_amt,
                "new_amount": new_amt,
                "message": f"Salary record for {updated_sal.get('staff_name')} ({updated_sal.get('month')}) updated from ₹{old_amt:,.0f} to ₹{new_amt:,.0f}."
            }
        else:
            return {
                "success": False,
                "action_executed": False,
                "error": f"No existing salary entry found matching staff '{staff_target}'."
            }

    elif func_name == "send_whatsapp_message":
        target = str(func_args.get("phone_or_name") or "").strip()
        custom_msg = (func_args.get("message") or "").strip()
        template = (func_args.get("template_name") or "").strip() or None

        recipient_phone = target
        matched_client = None
        for c in clients:
            c_phone = normalize_phone(c.get("phone") or "")
            c_name = str(c.get("name") or "").strip().lower()
            if target.lower() in c_name or (target.replace("+","").replace(" ","").isdigit() and normalize_phone(target) in c_phone):
                recipient_phone = c.get("phone")
                matched_client = c
                break

        res = whatsapp_engine.dispatch_whatsapp(recipient_phone, message_text=custom_msg or None, template_name=template)
        return {
            "action_executed": res.get("success", False),
            "recipient": recipient_phone,
            "client_name": matched_client.get("name") if matched_client else target,
            "api_result": res,
            "message": f"WhatsApp message successfully dispatched to {recipient_phone}" if res.get("success") else f"WhatsApp dispatch error: {res.get('error')}"
        }

    elif func_name == "update_client_status":
        target = str(func_args.get("phone_or_name") or "").strip()
        new_status = func_args.get("new_status")

        canonical_status = "Follow-up"
        if new_status:
            ns_lower = str(new_status).lower()
            if "interest" in ns_lower: canonical_status = "Interested"
            elif "convert" in ns_lower: canonical_status = "Converted"
            elif "new" in ns_lower: canonical_status = "New Lead"
            elif "lost" in ns_lower or "drop" in ns_lower: canonical_status = "Lost"

        updated_client = None
        old_status = None
        for c in clients:
            c_phone = normalize_phone(c.get("phone") or "")
            c_name = str(c.get("name") or "").strip().lower()
            if target.lower() in c_name or (target.replace("+","").replace(" ","").isdigit() and normalize_phone(target) in c_phone):
                old_status = c.get("status", "New Lead")
                c["status"] = canonical_status
                c["last_contact"] = "Just now"
                updated_client = c
                break

        if updated_client:
            with file_lock:
                try:
                    with open(CLIENTS_VAULT_PATH, "w", encoding="utf-8") as f:
                        json.dump(clients, f, ensure_ascii=False, indent=2)
                except:
                    pass

            return {
                "success": True,
                "action_executed": True,
                "action_type": "update_client_status",
                "client_name": updated_client.get("name"),
                "phone": updated_client.get("phone"),
                "previous_status": old_status,
                "new_status": canonical_status,
                "message": f"Status for '{updated_client.get('name')}' ({updated_client.get('phone')}) updated from '{old_status}' to '{canonical_status}'."
            }
        else:
            return {
                "success": False,
                "action_executed": False,
                "error": f"Client with identifier '{target}' not found in Client Vault."
            }

    elif func_name == "bulk_add_clients":
        contacts_list = func_args.get("contacts") or []
        if not isinstance(contacts_list, list):
            contacts_list = [contacts_list]

        added_clients = []
        already_present = []

        with file_lock:
            existing_numbers = set(normalize_phone(c.get("phone") or "") for c in clients if c.get("phone"))
            for idx, item in enumerate(contacts_list):
                if isinstance(item, str):
                    raw_ph = item
                    raw_nm = f"Lead {len(clients) + 1}"
                    raw_st = "New Lead"
                else:
                    raw_ph = str(item.get("phone") or "").strip()
                    raw_nm = str(item.get("name") or f"Lead {len(clients) + 1}").strip()
                    raw_st = str(item.get("status") or "New Lead").strip()

                norm_p = normalize_phone(raw_ph)
                if norm_p and norm_p in existing_numbers:
                    already_present.append(raw_ph)
                    continue

                new_c = {
                    "name": raw_nm,
                    "phone": raw_ph if raw_ph else "Pending",
                    "status": raw_st,
                    "last_contact": "Just now"
                }
                clients.insert(0, new_c)
                if norm_p:
                    existing_numbers.add(norm_p)
                added_clients.append(new_c)

            if added_clients:
                try:
                    with open(CLIENTS_VAULT_PATH, "w", encoding="utf-8") as f:
                        json.dump(clients, f, ensure_ascii=False, indent=2)
                except Exception as e:
                    pass

        return {
            "success": True,
            "action_executed": True if added_clients else False,
            "action_type": "bulk_add_clients",
            "added_count": len(added_clients),
            "total_clients": len(clients),
            "added_numbers": [c["phone"] for c in added_clients],
            "message": f"Successfully registered {len(added_clients)} new client contacts in bulk to CRM Vault."
        }

    elif func_name == "add_client":
        name = str(func_args.get("name") or "New Lead").strip().title()
        phone = str(func_args.get("phone") or "").strip()
        status = str(func_args.get("status") or "New Lead").strip()

        with file_lock:
            norm_phone = normalize_phone(phone)
            existing = next((c for c in clients if c.get("phone") and normalize_phone(c.get("phone")) == norm_phone), None) if norm_phone else None
            if existing:
                return {
                    "success": True,
                    "action_executed": False,
                    "already_exists": True,
                    "client_name": existing.get("name"),
                    "phone": existing.get("phone"),
                    "status": existing.get("status"),
                    "message": f"Client '{existing.get('name')}' ({existing.get('phone')}) is already present in your Client Vault."
                }

            new_client = {
                "name": name,
                "phone": phone if phone else "Pending",
                "status": status,
                "last_contact": "Just now"
            }
            clients.insert(0, new_client)
            try:
                with open(CLIENTS_VAULT_PATH, "w", encoding="utf-8") as f:
                    json.dump(clients, f, ensure_ascii=False, indent=2)
            except Exception as e:
                pass

        return {
            "success": True,
            "action_executed": True,
            "action_type": "add_client",
            "client_name": name,
            "phone": phone,
            "status": status,
            "message": f"New client '{name}' ({phone}) successfully added to CRM Vault under '{status}'."
        }

    elif func_name == "delete_client":
        target = str(func_args.get("phone_or_name") or "").strip()
        count_val = func_args.get("count")
        
        # If user asked for positional deletion (e.g. starting ki 3 leads)
        if count_val:
            try:
                num_to_delete = int(count_val)
            except:
                num_to_delete = 1
                
            removed_list = []
            with file_lock:
                actual_del = min(num_to_delete, len(clients))
                removed_list = [clients.pop(0) for _ in range(actual_del)]
                if removed_list:
                    try:
                        with open(CLIENTS_VAULT_PATH, "w", encoding="utf-8") as f:
                            json.dump(clients, f, ensure_ascii=False, indent=2)
                    except:
                        pass
            return {
                "success": True,
                "action_executed": True,
                "action_type": "delete_client",
                "deleted_count": len(removed_list),
                "remaining_count": len(clients),
                "message": f"Successfully removed top {len(removed_list)} leads from the beginning of Client Vault."
            }

        deleted_client = None
        with file_lock:
            for idx, c in enumerate(clients):
                c_phone = normalize_phone(c.get("phone") or "")
                c_name = str(c.get("name") or "").strip().lower()
                if target.lower() in c_name or (target.replace("+","").replace(" ","").isdigit() and normalize_phone(target) in c_phone):
                    deleted_client = clients.pop(idx)
                    break

            if deleted_client:
                try:
                    with open(CLIENTS_VAULT_PATH, "w", encoding="utf-8") as f:
                        json.dump(clients, f, ensure_ascii=False, indent=2)
                except:
                    pass

        if deleted_client:
            return {
                "success": True,
                "action_executed": True,
                "action_type": "delete_client",
                "client_name": deleted_client.get("name"),
                "phone": deleted_client.get("phone"),
                "message": f"Client '{deleted_client.get('name')}' ({deleted_client.get('phone')}) removed from CRM Vault."
            }
        else:
            return {
                "success": False,
                "action_executed": False,
                "error": f"Client '{target}' not found in CRM Vault."
            }

    elif func_name == "delete_invoice":
        target_id = str(func_args.get("invoice_id") or "").strip().upper()
        target_client = str(func_args.get("client_name") or "").strip().lower()

        inv_path = os.path.join(DATA_DIR, "invoices_vault.json")
        items = []
        if os.path.exists(inv_path):
            try:
                with open(inv_path, "r", encoding="utf-8") as f:
                    items = json.load(f)
            except: pass

        orig_len = len(items)
        if target_id == "ALL" or "ALL" in target_id or not (target_id or target_client):
            items = []
        elif target_id:
            items = [it for it in items if it.get("id", "").upper() != target_id]
        elif target_client:
            items = [it for it in items if target_client not in str(it.get("client_name", "")).lower()]

        with file_lock:
            try:
                with open(inv_path, "w", encoding="utf-8") as f:
                    json.dump(items, f, ensure_ascii=False, indent=2)
            except: pass

        del_count = orig_len - len(items)
        return {
            "success": True,
            "action_executed": True,
            "action_type": "delete_invoice",
            "deleted_count": del_count,
            "message": f"Successfully deleted {del_count} invoice record(s) from Invoices Vault."
        }

    elif func_name == "schedule_meeting":
        c_name = str(func_args.get("client_name") or "Client").strip().title()
        title = str(func_args.get("title") or f"Consultation with {c_name}").strip()
        host = str(func_args.get("host") or "Administrator").strip()
        time_val = str(func_args.get("time") or "15:00").strip()
        date_val = str(func_args.get("date") or datetime.now().strftime("%Y-%m-%d")).strip()

        mtg_path = os.path.join(DATA_DIR, "meetings_vault.json")
        items = []
        if os.path.exists(mtg_path):
            try:
                with open(mtg_path, "r", encoding="utf-8") as f:
                    items = json.load(f)
            except: pass

        new_mtg = {
            "id": f"MTG-{int(time.time()) % 10000}",
            "title": title,
            "client_name": c_name,
            "client_email": f"{c_name.lower().replace(' ', '')}@example.com",
            "date": date_val if len(date_val) == 10 else datetime.now().strftime("%Y-%m-%d"),
            "time": time_val,
            "duration": "30 mins",
            "host": host,
            "meet_link": generate_standard_meet_link(),
            "notes": f"Scheduled via Achyuta AI on {datetime.now().strftime('%d %b %Y')}"
        }

        with file_lock:
            items.insert(0, new_mtg)
            try:
                with open(mtg_path, "w", encoding="utf-8") as f:
                    json.dump(items, f, ensure_ascii=False, indent=2)
            except: pass

        return {
            "success": True,
            "action_executed": True,
            "action_type": "schedule_meeting",
            "meeting_id": new_mtg["id"],
            "client_name": c_name,
            "date": new_mtg["date"],
            "time": new_mtg["time"],
            "message": f"Meeting with {c_name} scheduled successfully for {new_mtg['date']} at {new_mtg['time']}."
        }

    elif func_name == "trigger_outbound_call":
        phone = str(func_args.get("phone") or "").strip()
        c_name = str(func_args.get("customer_name") or "Customer").strip()

        # If phone contains letters, lookup client
        if not re.search(r'\d{6,}', phone):
            for c in clients:
                if phone.lower() in str(c.get("name") or "").lower():
                    phone = c.get("phone")
                    c_name = c.get("name")
                    break

        success, msg, res = trigger_ai_outbound_call(phone, c_name)
        return {
            "success": success,
            "action_executed": True,
            "action_type": "trigger_outbound_call",
            "phone": phone,
            "customer_name": c_name,
            "message": f"AI Outbound call to {phone} ({c_name}) initiated via Telephony Gateway."
        }

    elif func_name == "create_task":
        title = str(func_args.get("title") or "Follow-up Task").strip()
        assigned_to = str(func_args.get("assigned_to") or "Administrator").strip()
        priority = str(func_args.get("priority") or "Normal").strip().title()
        client_name = str(func_args.get("client_name") or "").strip()

        new_task = {
            "id": str(int(datetime.now().timestamp() * 1000)),
            "title": title,
            "assigned_to": assigned_to,
            "priority": priority,
            "client_name": client_name,
            "status": "Pending",
            "due_date": "Today",
            "created_at": datetime.now().isoformat()
        }
        with file_lock:
            tasks.insert(0, new_task)
            try:
                with open(TASKS_VAULT_PATH, "w", encoding="utf-8") as f:
                    json.dump(tasks, f, ensure_ascii=False, indent=2)
            except:
                pass

        return {
            "success": True,
            "action_executed": True,
            "action_type": "create_task",
            "task_id": new_task["id"],
            "title": title,
            "assigned_to": assigned_to,
            "priority": priority,
            "message": f"Task '{title}' assigned to {assigned_to} with priority {priority}."
        }

    elif func_name == "update_task_status":
        identifier = str(func_args.get("task_identifier") or "").strip().lower()
        new_stat = str(func_args.get("new_status") or "Completed").strip().title()
        if "Approv" in new_stat or "Done" in new_stat:
            canonical_task_status = "Completed"
        elif "Prog" in new_stat:
            canonical_task_status = "In Progress"
        else:
            canonical_task_status = "Completed"

        tasks_path = os.path.join(DATA_DIR, "tasks_vault.json")
        items = []
        if os.path.exists(tasks_path):
            try:
                with open(tasks_path, "r", encoding="utf-8") as f:
                    items = json.load(f)
            except: pass

        updated_task = None
        keywords = [k for k in re.split(r'[\s\-_]+', identifier) if len(k) >= 3]
        for t in items:
            t_id = str(t.get("id") or "").lower()
            t_title = str(t.get("title") or "").lower()
            t_assignee = str(t.get("assigned_to") or t.get("assignee") or "").lower()
            
            # Exact or substring match
            if identifier in t_id or identifier in t_title or identifier in t_assignee:
                t["status"] = canonical_task_status
                updated_task = t
                break
            
            # Word-level fuzzy match (e.g. 'nikhil meeting' matches 'Meeting with Nikhil at 11:00 AM')
            if any(k in t_title or k in t_assignee for k in keywords):
                t["status"] = canonical_task_status
                updated_task = t
                break

        if updated_task:
            with file_lock:
                try:
                    with open(tasks_path, "w", encoding="utf-8") as f:
                        json.dump(items, f, ensure_ascii=False, indent=2)
                except: pass
            return {
                "success": True,
                "action_executed": True,
                "action_type": "update_task_status",
                "task": updated_task,
                "message": f"Task '{updated_task.get('title')}' status updated to '{canonical_task_status}'."
            }
        else:
            return {
                "success": False,
                "action_executed": False,
                "error": f"No task matching '{identifier}' found in tasks queue."
            }

    elif func_name == "delete_task":
        task_id = str(func_args.get("task_id") or "").strip().lower()
        title_q = str(func_args.get("title_query") or "").strip().lower()

        tasks_path = os.path.join(DATA_DIR, "tasks_vault.json")
        items = []
        if os.path.exists(tasks_path):
            try:
                with open(tasks_path, "r", encoding="utf-8") as f:
                    items = json.load(f)
            except: pass

        orig_len = len(items)
        if task_id in ["all", "everything", "any"] or "all" in task_id or not (task_id or title_q):
            items = []
        elif task_id:
            items = [t for t in items if str(t.get("id", "")).lower() != task_id]
        elif title_q:
            items = [t for t in items if title_q not in str(t.get("title", "")).lower()]

        with file_lock:
            try:
                with open(tasks_path, "w", encoding="utf-8") as f:
                    json.dump(items, f, ensure_ascii=False, indent=2)
            except: pass

        del_count = orig_len - len(items)
        return {
            "success": True,
            "action_executed": True,
            "action_type": "delete_task",
            "deleted_count": del_count,
            "message": f"Tasks vault se total {del_count} task(s) delete kar diye gaye hain. Tasks list ab empty hai."
        }

    if func_name == "search_crm_database":
        query = (func_args.get("query") or "").strip().lower()
        status_filter = (func_args.get("status") or "").strip().lower()
        
        matches = []
        for c in clients:
            c_name = str(c.get("name") or "").lower()
            c_phone = normalize_phone(c.get("phone") or "")
            c_status = str(c.get("status") or "").lower()
            
            # Check match
            name_match = query in c_name if query else True
            phone_match = (query.replace(" ", "") in c_phone) if (query and query.replace(" ", "").isdigit()) else False
            status_match = (status_filter in c_status) if status_filter else True
            
            if (name_match or phone_match) and status_match:
                matches.append({
                    "name": c.get("name"),
                    "phone": c.get("phone"),
                    "status": c.get("status", "New Lead"),
                    "last_contact": c.get("last_contact") or c.get("last_followup") or "Pending"
                })

        return {
            "search_query": query,
            "total_matches_found": len(matches),
            "matched_records": matches[:10]
        }

    elif func_name == "get_crm_vault_summary":
        total = len(clients)
        new_count = len([c for c in clients if "new" in str(c.get("status") or "").lower()])
        follow_count = len([c for c in clients if "follow" in str(c.get("status") or "").lower()])
        interested_count = len([c for c in clients if "interest" in str(c.get("status") or "").lower()])
        return {
            "total_contacts": total,
            "new_leads": new_count,
            "follow_up_due": follow_count,
            "interested": interested_count
        }

    elif func_name == "get_recent_clients":
        limit = int(func_args.get("limit") or 5)
        return {
            "recent_records": clients[:limit]
        }

    elif func_name == "add_staff_member":
        name = str(func_args.get("name", "")).strip()
        phone = str(func_args.get("phone", "")).strip()
        role = str(func_args.get("role", "Staff Member")).strip()
        salary = float(func_args.get("monthly_salary", 0) or 0)
        email = str(func_args.get("email", "")).strip()

        if not name:
            return {"error": "Staff member name is required"}

        # Normalize username from name
        username = re.sub(r'[^a-zA-Z0-9]', '', name.lower())
        if not username:
            username = f"staff{int(time.time()) % 1000}"

        users_path = os.path.join(DATA_DIR, "users_vault.json")
        users = []
        if os.path.exists(users_path):
            try:
                with open(users_path, "r", encoding="utf-8") as f:
                    users = json.load(f)
            except:
                users = []

        # Make username unique if already exists
        base_user = username
        counter = 1
        while any(u.get("username", "").lower() == username for u in users):
            username = f"{base_user}{counter}"
            counter += 1

        staff_entry = {
            "username": username,
            "email": email or f"{username}@achyuta.ai",
            "password": f"{username}123",
            "name": name,
            "role": role,
            "phone": phone,
            "monthly_salary": salary,
            "joining_date": datetime.now().strftime("%Y-%m-%d"),
            "status": "Active",
            "initial": name[0].upper()
        }
        users.append(staff_entry)
        try:
            with open(users_path, "w", encoding="utf-8") as f:
                json.dump(users, f, ensure_ascii=False, indent=2)
        except Exception as e:
            return {"error": f"Failed to save staff vault: {e}"}

        return {
            "action_executed": True,
            "success": True,
            "action": "staff_added",
            "name": name,
            "username": username,
            "phone": phone,
            "role": role,
            "monthly_salary": salary,
            "message": f"Staff member '{name}' successfully registered into directory."
        }

    elif func_name == "delete_staff_member":
        target = str(func_args.get("name_or_username", "")).strip().lower()
        if not target or target == "admin":
            return {"error": "Valid non-admin staff member name or username is required"}

        users_path = os.path.join(DATA_DIR, "users_vault.json")
        users = []
        if os.path.exists(users_path):
            try:
                with open(users_path, "r", encoding="utf-8") as f:
                    users = json.load(f)
            except:
                users = []

        orig_len = len(users)
        removed_name = target
        new_users = []
        for u in users:
            u_user = u.get("username", "").lower()
            u_name = u.get("name", "").lower()
            if target == u_user or target in u_name:
                removed_name = u.get("name", target)
                continue
            new_users.append(u)

        if len(new_users) < orig_len:
            try:
                with open(users_path, "w", encoding="utf-8") as f:
                    json.dump(new_users, f, ensure_ascii=False, indent=2)
            except Exception as e:
                return {"error": f"Failed to update users vault: {e}"}
            return {
                "action_executed": True,
                "success": True,
                "message": f"Staff member '{removed_name}' successfully removed."
            }
        return {"error": f"Staff member '{target}' not found in directory"}

    elif func_name == "create_invoice":
        client_name = str(func_args.get("client_name", "")).strip()
        amt = float(func_args.get("amount", 0) or 0)
        inv_type = str(func_args.get("type", "Invoice")).strip()
        status = str(func_args.get("status", "Pending")).strip()
        desc = str(func_args.get("description", "Professional Services")).strip()

        fpath = os.path.join(DATA_DIR, "invoices_vault.json")
        items = []
        if os.path.exists(fpath):
            try:
                with open(fpath, "r", encoding="utf-8") as f:
                    items = json.load(f)
            except:
                items = []

        prefix = "INV-" if inv_type == "Invoice" else "QUO-"
        rec = {
            "id": f"{prefix}{str(int(time.time()))[-4:]}",
            "client_name": client_name,
            "amount": amt,
            "type": inv_type,
            "status": status,
            "description": desc,
            "date": datetime.now().strftime("%Y-%m-%d"),
            "due_date": datetime.now().strftime("%Y-%m-%d")
        }
        items.insert(0, rec)
        try:
            with open(fpath, "w", encoding="utf-8") as f:
                json.dump(items, f, ensure_ascii=False, indent=2)
        except Exception as e:
            return {"error": f"Failed to save invoice: {e}"}

        return {
            "action_executed": True,
            "success": True,
            "action": "invoice_created",
            "invoice": rec,
            "message": f"{inv_type} for '{client_name}' of amount INR {amt} generated successfully."
        }

    elif func_name == "add_reminder":
        title = str(func_args.get("title", "")).strip()
        r_date = str(func_args.get("date", "Today")).strip()
        r_time = str(func_args.get("time", "10:00 AM")).strip()

        fpath = os.path.join(DATA_DIR, "reminders_vault.json")
        items = []
        if os.path.exists(fpath):
            try:
                with open(fpath, "r", encoding="utf-8") as f:
                    items = json.load(f)
            except:
                items = []

        rec = {
            "id": f"REM-{str(int(time.time()))[-4:]}",
            "title": title,
            "date": r_date,
            "time": r_time,
            "is_completed": False
        }
        items.insert(0, rec)
        try:
            with open(fpath, "w", encoding="utf-8") as f:
                json.dump(items, f, ensure_ascii=False, indent=2)
        except Exception as e:
            return {"error": f"Failed to save reminder: {e}"}

        return {
            "action_executed": True,
            "success": True,
            "action": "reminder_added",
            "reminder": rec,
            "message": f"Reminder '{title}' set for {r_date} at {r_time}."
        }

    elif func_name == "toggle_reminder":
        query = str(func_args.get("reminder_query", "")).strip().lower()
        fpath = os.path.join(DATA_DIR, "reminders_vault.json")
        items = []
        if os.path.exists(fpath):
            try:
                with open(fpath, "r", encoding="utf-8") as f:
                    items = json.load(f)
            except:
                items = []

        found = False
        new_state = True
        for r in items:
            if query == str(r.get("id", "")).lower() or query in str(r.get("title", "")).lower():
                r["is_completed"] = not r.get("is_completed", False)
                new_state = r["is_completed"]
                found = True
                break

        if found:
            try:
                with open(fpath, "w", encoding="utf-8") as f:
                    json.dump(items, f, ensure_ascii=False, indent=2)
            except Exception as e:
                return {"error": f"Failed to save reminder state: {e}"}
            return {
                "action_executed": True,
                "success": True,
                "message": f"Reminder status updated to {'Completed' if new_state else 'Pending'}."
            }
        return {"error": f"Reminder matching '{query}' not found"}

    elif func_name == "record_attendance":
        staff_name = str(func_args.get("staff_name", "")).strip()
        status = str(func_args.get("status", "Present")).strip()
        att_date = str(func_args.get("date", "Today")).strip()

        fpath = os.path.join(DATA_DIR, "attendance_vault.json")
        items = []
        if os.path.exists(fpath):
            try:
                with open(fpath, "r", encoding="utf-8") as f:
                    items = json.load(f)
            except:
                items = []

        rec = {
            "id": f"ATT-{str(int(time.time()))[-4:]}",
            "staff_name": staff_name,
            "status": status,
            "date": datetime.now().strftime("%Y-%m-%d") if att_date.lower() == "today" else att_date,
            "punch_time": datetime.now().strftime("%I:%M %p")
        }
        items.insert(0, rec)
        try:
            with open(fpath, "w", encoding="utf-8") as f:
                json.dump(items, f, ensure_ascii=False, indent=2)
        except Exception as e:
            return {"error": f"Failed to save attendance: {e}"}

        return {
            "action_executed": True,
            "success": True,
            "action": "attendance_recorded",
            "attendance": rec,
            "message": f"Attendance marked '{status}' for {staff_name}."
        }

    elif func_name == "create_ticket":
        cust = str(func_args.get("customer_name", "")).strip()
        subj = str(func_args.get("subject", "")).strip()
        prio = str(func_args.get("priority", "Normal")).strip()

        fpath = os.path.join(DATA_DIR, "tickets_vault.json")
        items = []
        if os.path.exists(fpath):
            try:
                with open(fpath, "r", encoding="utf-8") as f:
                    items = json.load(f)
            except:
                items = []

        t_id = f"TCK-{str(int(time.time()))[-4:]}"
        rec = {
            "id": t_id,
            "ticket_no": t_id,
            "customer_name": cust,
            "subject": subj,
            "priority": prio,
            "status": "Open",
            "created_at": datetime.now().strftime("%Y-%m-%d %I:%M %p")
        }
        items.insert(0, rec)
        try:
            with open(fpath, "w", encoding="utf-8") as f:
                json.dump(items, f, ensure_ascii=False, indent=2)
        except Exception as e:
            return {"error": f"Failed to save ticket: {e}"}

        return {
            "action_executed": True,
            "success": True,
            "action": "ticket_created",
            "ticket": rec,
            "message": f"Support Ticket {t_id} opened for {cust}: '{subj}'."
        }

    elif func_name == "update_ticket_status":
        query = str(func_args.get("ticket_query", "")).strip().lower()
        new_status = str(func_args.get("new_status", "Resolved")).strip()

        fpath = os.path.join(DATA_DIR, "tickets_vault.json")
        items = []
        if os.path.exists(fpath):
            try:
                with open(fpath, "r", encoding="utf-8") as f:
                    items = json.load(f)
            except:
                items = []

        found = False
        t_id_res = query
        for t in items:
            if query == str(t.get("id", "")).lower() or query in str(t.get("customer_name", "")).lower() or query in str(t.get("subject", "")).lower():
                t["status"] = new_status
                t_id_res = t.get("id", query)
                found = True
                break

        if found:
            try:
                with open(fpath, "w", encoding="utf-8") as f:
                    json.dump(items, f, ensure_ascii=False, indent=2)
            except Exception as e:
                return {"error": f"Failed to update ticket: {e}"}
            return {
                "action_executed": True,
                "success": True,
                "message": f"Ticket {t_id_res} status updated to '{new_status}'."
            }
        return {"error": f"Support Ticket matching '{query}' not found"}

    return {"error": f"Function {func_name} not recognized"}

SYSTEM_PROMPT = """You are Achyuta, a world-class executive AI business administrator and operational intelligence agent for enterprise CRM.

CRITICAL OPERATIONAL MANDATES:
1. STRICT ZERO EMOJIS POLICY: Never output any emojis under any circumstance. Maintain an ultra-professional, calm, executive demeanor.
2. TONE & INTELLECT: Speak naturally with high executive clarity, authority, and structured precision. Be actionable, concise, and helpful.
3. PROFESSIONAL ENGLISH FOR ALL DATABASE ENTRIES & RECORDS:
   - ALL database record fields (task titles, financial transaction descriptions, meeting agendas, notes, client designations) MUST ALWAYS BE RECORDED IN CLEAN, PROFESSIONAL ENGLISH.
   - Even if the user speaks in Hindi, Hinglish, or casual phrases (e.g. 'nikhil se meeting karni hai subah 11:00', '500rs rohit ko de diya', 'server buy kiya', 'office rent 15000'), YOU MUST AUTOMATICALLY TRANSLATE & FORMAT THE RECORD TITLE/NOTES INTO PROFESSIONAL ENGLISH before saving:
     - 'nikhil se meeting karni hai subah 11:00' -> Task title: 'Meeting with Nikhil at 11:00 AM'
     - '500rs rohit ko de diya' -> Transaction title: 'Payment to Rohit'
     - 'server buy kiya 1000rs' -> Transaction title: 'Server Infrastructure Purchase'
     - 'social media pe content upload karna hai' -> Task title: 'Publish Social Media Content'
   - NEVER save Hindi Devanagari script or broken romanized slang into database record titles or descriptions.
4. CONVERSATIONAL HINGLISH AS PRIMARY SPOKEN LANGUAGE:
   - Always reply back to the user in natural, polite conversational Hinglish (e.g. "Maine Nikhil ke saath 11:00 baje ki meeting ka task add kar diya hai.", "Aapka expense record ho gaya hai.").
   - For voice conversations, keep replies short, direct, and conversational (1 to 2 crisp sentences, max 25-35 words).
5. LIVE VISUAL CANVAS GENERATION (HTML/TAILWIND COMPONENTS):
   - ONLY generate a visual component when the user explicitly asks for visual, design, layout, mockup, car concept, calculation, or presentation.
   - For normal conversations, reply in 1-2 pure conversational Hinglish sentences.
6. NATIVE TOOL CALLING FOR CRM & FINANCIAL OPERATIONS:
   - FINANCIAL & EXPENSE TRACKING (ACCOUNTS LEDGER):
     When user mentions paying money, spending money, or receiving money, ALWAYS call 'record_financial_transaction' with a clean English title and category.
   - SALARY MANAGEMENT & CORRECTIONS:
     When user corrects salary, call 'update_salary_record'. When user pays salary, call 'pay_staff_salary'.
   - TASKS & OPERATIONS:
     When user asks to create or add a task, call 'create_task' with professional English title (e.g. 'Meeting with Nikhil at 11:00 AM').
   - MEETINGS & CALENDAR:
     When user asks to schedule a meeting, call 'schedule_meeting' with a professional English title.
   - STAFF & TEAM DIRECTORY:
     When user asks to add or register staff / employee (e.g. 'mere liye ek naya staff add kar do staff ka naam mohan hai aur phone number 1234567890'), ALWAYS call 'add_staff_member' with clean English name and role. When deleting staff, call 'delete_staff_member'.
   - INVOICES & BILLING:
     When user asks to create or generate an invoice/quotation, call 'create_invoice'. When deleting, call 'delete_invoice'.
   - REMINDERS & ALERTS:
     When user asks to set or add a reminder, call 'add_reminder'. When user completes a reminder, call 'toggle_reminder'.
   - ATTENDANCE & PUNCH:
     When user asks to mark or punch attendance for staff, call 'record_attendance'.
   - TICKETS & SUPPORT:
     When user asks to create or resolve a support ticket, call 'create_ticket' or 'update_ticket_status'.
   - WHATSAPP & CALLING:
     When user asks to WhatsApp, call 'send_whatsapp_message'. When user asks to call, call 'trigger_outbound_call'."""

class AchyutaWebHandler(SimpleHTTPRequestHandler):
    def do_GET(self):
        if self.path.startswith("/static/"):
            rel_path = self.path[8:].split('?')[0]
            static_file = os.path.join(DATA_DIR, "static", rel_path)
            if os.path.exists(static_file) and os.path.isfile(static_file):
                self.send_response(200)
                if static_file.endswith(".jpg") or static_file.endswith(".jpeg"):
                    self.send_header("Content-Type", "image/jpeg")
                elif static_file.endswith(".png"):
                    self.send_header("Content-Type", "image/png")
                elif static_file.endswith(".svg"):
                    self.send_header("Content-Type", "image/svg+xml")
                else:
                    self.send_header("Content-Type", "application/octet-stream")
                self.send_header("Cache-Control", "public, max-age=86400")
                self.end_headers()
                with open(static_file, "rb") as f:
                    self.wfile.write(f.read())
                return
            else:
                self.send_response(404)
                self.end_headers()
                return
        if self.path == "/" or self.path == "/index.html":
            self.send_response(200)
            self.send_header("Content-Type", "text/html; charset=utf-8")
            self.end_headers()
            with open(os.path.join(DATA_DIR, "index.html"), "rb") as f:
                self.wfile.write(f.read())
            return
        elif self.path == "/api/voice_agent/logs":
            logs = get_ai_call_logs_data()
            self.send_response(200)
            self.send_header("Content-Type", "application/json")
            self.end_headers()
            self.wfile.write(json.dumps({
                "success": True,
                "logs": logs,
                "total_calls": len(logs),
                "completed_calls": len([l for l in logs if l.get("call_status") == "Completed"])
            }).encode("utf-8"))
            return

        elif self.path == "/api/clients":
            self.send_response(200)
            self.send_header("Content-Type", "application/json")
            self.end_headers()
            clients = []
            if os.path.exists(CLIENTS_VAULT_PATH):
                try:
                    with open(CLIENTS_VAULT_PATH, "r", encoding="utf-8") as f:
                        clients = json.load(f)
                except:
                    pass
            self.wfile.write(json.dumps(clients).encode("utf-8"))
            return
        elif self.path == "/api/staff":
            self.send_response(200)
            self.send_header("Content-Type", "application/json")
            self.end_headers()
            users_path = os.path.join(DATA_DIR, "users_vault.json")
            users = []
            if os.path.exists(users_path):
                try:
                    with open(users_path, "r", encoding="utf-8") as f:
                        users = json.load(f)
                except:
                    pass
            # Don't expose passwords in staff list, include salary info
            sanitized = [{
                "username": u.get("username", ""),
                "email": u.get("email", ""),
                "name": u.get("name", ""),
                "role": u.get("role", "Staff Member"),
                "phone": u.get("phone", ""),
                "designation": u.get("designation", u.get("role", "Staff Member")),
                "monthly_salary": float(u.get("monthly_salary", 0)),
                "joining_date": u.get("joining_date", ""),
                "status": u.get("status", "Active"),
                "initial": u.get("initial", u.get("name", "U")[0].upper())
            } for u in users]
            self.wfile.write(json.dumps(sanitized).encode("utf-8"))
            return
        elif self.path == "/api/tasks":
            self.send_response(200)
            self.send_header("Content-Type", "application/json")
            self.end_headers()
            tasks_path = os.path.join(DATA_DIR, "tasks_vault.json")
            tasks = []
            if os.path.exists(tasks_path):
                try:
                    with open(tasks_path, "r", encoding="utf-8") as f:
                        tasks = json.load(f)
                except:
                    pass
            self.wfile.write(json.dumps(tasks).encode("utf-8"))
            return
        elif self.path == "/api/accounts":
            self.send_response(200)
            self.send_header("Content-Type", "application/json")
            self.end_headers()
            acc_path = os.path.join(DATA_DIR, "accounts_vault.json")
            txns = []
            if os.path.exists(acc_path):
                try:
                    with open(acc_path, "r", encoding="utf-8") as f:
                        txns = json.load(f)
                except:
                    pass
            self.wfile.write(json.dumps(txns).encode("utf-8"))
            return
        elif self.path == "/api/salary":
            self.send_response(200)
            self.send_header("Content-Type", "application/json")
            self.end_headers()
            sal_path = os.path.join(DATA_DIR, "salary_vault.json")
            salaries = []
            if os.path.exists(sal_path):
                try:
                    with open(sal_path, "r", encoding="utf-8") as f:
                        salaries = json.load(f)
                except:
                    pass
            self.wfile.write(json.dumps(salaries).encode("utf-8"))
            return
        elif self.path == "/api/attendance":
            self.send_response(200)
            self.send_header("Content-Type", "application/json")
            self.end_headers()
            fpath = os.path.join(DATA_DIR, "attendance_vault.json")
            items = []
            if os.path.exists(fpath):
                try:
                    with open(fpath, "r", encoding="utf-8") as f:
                        items = json.load(f)
                except:
                    pass
            self.wfile.write(json.dumps(items).encode("utf-8"))
            return
        elif self.path == "/api/invoices":
            self.send_response(200)
            self.send_header("Content-Type", "application/json")
            self.end_headers()
            fpath = os.path.join(DATA_DIR, "invoices_vault.json")
            items = []
            if os.path.exists(fpath):
                try:
                    with open(fpath, "r", encoding="utf-8") as f:
                        items = json.load(f)
                except:
                    pass
            self.wfile.write(json.dumps(items).encode("utf-8"))
            return
        elif self.path == "/api/tickets":
            self.send_response(200)
            self.send_header("Content-Type", "application/json")
            self.end_headers()
            fpath = os.path.join(DATA_DIR, "tickets_vault.json")
            items = []
            if os.path.exists(fpath):
                try:
                    with open(fpath, "r", encoding="utf-8") as f:
                        items = json.load(f)
                except:
                    pass
            self.wfile.write(json.dumps(items).encode("utf-8"))
            return
        elif self.path == "/api/meetings":
            self.send_response(200)
            self.send_header("Content-Type", "application/json")
            self.end_headers()
            fpath = os.path.join(DATA_DIR, "meetings_vault.json")
            items = []
            if os.path.exists(fpath):
                try:
                    with open(fpath, "r", encoding="utf-8") as f:
                        items = json.load(f)
                except:
                    pass
            self.wfile.write(json.dumps(items).encode("utf-8"))
            return
        elif self.path == "/api/reminders":
            self.send_response(200)
            self.send_header("Content-Type", "application/json")
            self.end_headers()
            fpath = os.path.join(DATA_DIR, "reminders_vault.json")
            items = []
            if os.path.exists(fpath):
                try:
                    with open(fpath, "r", encoding="utf-8") as f:
                        items = json.load(f)
                except:
                    pass
            self.wfile.write(json.dumps(items).encode("utf-8"))
            return
        elif self.path == "/api/contracts":
            self.send_response(200)
            self.send_header("Content-Type", "application/json")
            self.end_headers()
            fpath = os.path.join(DATA_DIR, "contracts_vault.json")
            items = []
            if os.path.exists(fpath):
                try:
                    with open(fpath, "r", encoding="utf-8") as f:
                        items = json.load(f)
                except:
                    pass
            self.wfile.write(json.dumps(items).encode("utf-8"))
            return
        elif self.path.startswith("/api/voice/quota_check"):
            # Real-time check to verify if AI Model has available quota before opening voice session
            is_quota_ok, retry_time = check_gemini_voice_quota()
            self.send_response(200)
            self.send_header("Content-Type", "application/json")
            self.end_headers()
            self.wfile.write(json.dumps({
                "allowed": is_quota_ok,
                "error_type": "quota_limit" if not is_quota_ok else None,
                "retry_time": retry_time,
                "message": f"Daily voice quota limit reached. Resets in {retry_time}." if not is_quota_ok else "Quota OK"
            }).encode("utf-8"))
            return
        super().do_GET()

    def do_POST(self):
        if self.path == "/api/login":
            content_length = int(self.headers.get('Content-Length', 0))
            body = self.rfile.read(content_length).decode('utf-8')
            data = json.loads(body)
            user_id = data.get("id", "").strip().lower()
            password = data.get("password", "").strip()

            users_path = os.path.join(DATA_DIR, "users_vault.json")
            users = []
            if os.path.exists(users_path):
                try:
                    with open(users_path, "r", encoding="utf-8") as f:
                        users = json.load(f)
                except:
                    pass

            matched = None
            for u in users:
                if (u.get("username", "").lower() == user_id or u.get("email", "").lower() == user_id) and u.get("password") == password:
                    matched = u
                    break

            if matched:
                self.send_response(200)
                self.send_header("Content-Type", "application/json")
                self.end_headers()
                self.wfile.write(json.dumps({
                    "success": True,
                    "user": {
                        "name": matched["name"],
                        "email": matched["email"],
                        "role": matched.get("role", "Executive"),
                        "initial": matched.get("initial", matched["name"][0].upper())
                    }
                }).encode("utf-8"))
            else:
                self.send_response(401)
                self.send_header("Content-Type", "application/json")
                self.end_headers()
                self.wfile.write(json.dumps({
                    "success": False,
                    "error": "Access Denied: Invalid ID or Password."
                }).encode("utf-8"))
            return

        elif self.path == "/api/voice_agent/trigger":
            content_length = int(self.headers.get('Content-Length', 0))
            body = self.rfile.read(content_length).decode('utf-8')
            data = json.loads(body)
            phone = data.get("phone", "")
            name = data.get("customer_name", "Customer")
            success, msg, resp_data = trigger_ai_outbound_call(phone, name)
            
            self.send_response(200 if success else 400)
            self.send_header("Content-Type", "application/json")
            self.end_headers()
            self.wfile.write(json.dumps({
                "success": success,
                "message": msg,
                "data": resp_data
            }).encode("utf-8"))
            return
        elif self.path == "/api/clients/add":
            content_length = int(self.headers.get('Content-Length', 0))
            body = self.rfile.read(content_length).decode('utf-8')
            new_client = json.loads(body)
            
            clients = []
            if os.path.exists(CLIENTS_VAULT_PATH):
                try:
                    with open(CLIENTS_VAULT_PATH, "r", encoding="utf-8") as f:
                        clients = json.load(f)
                except:
                    pass
            
            # Prepend newest lead
            clients.insert(0, new_client)
            try:
                with open(CLIENTS_VAULT_PATH, "w", encoding="utf-8") as f:
                    json.dump(clients, f, ensure_ascii=False, indent=2)
            except:
                pass
                
            self.send_response(200)
            self.send_header("Content-Type", "application/json")
            self.end_headers()
            self.wfile.write(json.dumps({"success": True, "count": len(clients), "client": new_client}).encode("utf-8"))
            return

        elif self.path == "/api/clients/update":
            content_length = int(self.headers.get('Content-Length', 0))
            body = self.rfile.read(content_length).decode('utf-8')
            payload = json.loads(body)
            phone_target = str(payload.get("original_phone") or payload.get("phone") or "").strip()
            
            clients = []
            if os.path.exists(CLIENTS_VAULT_PATH):
                try:
                    with open(CLIENTS_VAULT_PATH, "r", encoding="utf-8") as f:
                        clients = json.load(f)
                except:
                    pass
            
            updated = False
            for c in clients:
                if str(c.get("phone", "")).strip() == phone_target:
                    if "name" in payload: c["name"] = payload["name"]
                    if "phone" in payload: c["phone"] = payload["phone"]
                    if "status" in payload: c["status"] = payload["status"]
                    if "last_contact" in payload: c["last_contact"] = payload["last_contact"]
                    updated = True
                    break
                    
            if updated:
                try:
                    with open(CLIENTS_VAULT_PATH, "w", encoding="utf-8") as f:
                        json.dump(clients, f, ensure_ascii=False, indent=2)
                except:
                    pass

            self.send_response(200)
            self.send_header("Content-Type", "application/json")
            self.end_headers()
            self.wfile.write(json.dumps({"success": updated}).encode("utf-8"))
            return

        elif self.path == "/api/clients/delete":
            content_length = int(self.headers.get('Content-Length', 0))
            body = self.rfile.read(content_length).decode('utf-8')
            payload = json.loads(body)
            phone_target = str(payload.get("phone") or "").strip()
            name_target = str(payload.get("name") or "").strip().lower()
            
            clients = []
            if os.path.exists(CLIENTS_VAULT_PATH):
                try:
                    with open(CLIENTS_VAULT_PATH, "r", encoding="utf-8") as f:
                        clients = json.load(f)
                except:
                    pass
            
            orig_len = len(clients)
            clients = [c for c in clients if not (str(c.get("phone", "")).strip() == phone_target and (not name_target or str(c.get("name", "")).strip().lower() == name_target))]
            deleted = len(clients) < orig_len
            
            if deleted:
                try:
                    with open(CLIENTS_VAULT_PATH, "w", encoding="utf-8") as f:
                        json.dump(clients, f, ensure_ascii=False, indent=2)
                except:
                    pass

            self.send_response(200)
            self.send_header("Content-Type", "application/json")
            self.end_headers()
            self.wfile.write(json.dumps({"success": deleted, "count": len(clients)}).encode("utf-8"))
            return

        elif self.path == "/api/clients/bulk_upload":
            content_length = int(self.headers.get('Content-Length', 0))
            body = self.rfile.read(content_length).decode('utf-8')
            payload = json.loads(body)
            new_leads = payload.get("clients", [])
            
            clients = []
            if os.path.exists(CLIENTS_VAULT_PATH):
                try:
                    with open(CLIENTS_VAULT_PATH, "r", encoding="utf-8") as f:
                        clients = json.load(f)
                except:
                    pass
            
            # Prepend all new leads
            clients = new_leads + clients
            try:
                with open(CLIENTS_VAULT_PATH, "w", encoding="utf-8") as f:
                    json.dump(clients, f, ensure_ascii=False, indent=2)
            except:
                pass

            self.send_response(200)
            self.send_header("Content-Type", "application/json")
            self.end_headers()
            self.wfile.write(json.dumps({"success": True, "added": len(new_leads), "total": len(clients)}).encode("utf-8"))
            return

        elif self.path == "/api/staff/add":
            content_length = int(self.headers.get('Content-Length', 0))
            body = self.rfile.read(content_length).decode('utf-8')
            new_staff = json.loads(body)
            
            username = str(new_staff.get("username", "")).strip().lower()
            password = str(new_staff.get("password", "")).strip()
            name = str(new_staff.get("name", "")).strip()
            email = str(new_staff.get("email", "")).strip().lower()
            role = str(new_staff.get("role", "Staff Member")).strip()
            phone = str(new_staff.get("phone", "")).strip()
            monthly_salary = float(new_staff.get("monthly_salary", 0))
            joining_date = str(new_staff.get("joining_date", "")).strip()
            
            if not username or not password or not name:
                self.send_response(400)
                self.send_header("Content-Type", "application/json")
                self.end_headers()
                self.wfile.write(json.dumps({"success": False, "error": "Username, name, and password are required."}).encode("utf-8"))
                return

            users_path = os.path.join(DATA_DIR, "users_vault.json")
            users = []
            if os.path.exists(users_path):
                try:
                    with open(users_path, "r", encoding="utf-8") as f:
                        users = json.load(f)
                except:
                    pass
            
            # Check duplicate username/email
            for u in users:
                if u.get("username", "").lower() == username or (email and u.get("email", "").lower() == email):
                    self.send_response(400)
                    self.send_header("Content-Type", "application/json")
                    self.end_headers()
                    self.wfile.write(json.dumps({"success": False, "error": "Staff username or email already exists."}).encode("utf-8"))
                    return

            staff_entry = {
                "username": username,
                "email": email or f"{username}@achyuta.ai",
                "password": password,
                "name": name,
                "role": role,
                "phone": phone,
                "monthly_salary": monthly_salary,
                "joining_date": joining_date,
                "status": "Active",
                "initial": name[0].upper()
            }
            users.append(staff_entry)
            
            try:
                with open(users_path, "w", encoding="utf-8") as f:
                    json.dump(users, f, ensure_ascii=False, indent=2)
            except:
                pass

            self.send_response(200)
            self.send_header("Content-Type", "application/json")
            self.end_headers()
            self.wfile.write(json.dumps({
                "success": True, 
                "total_staff": len(users),
                "staff": {
                    "username": staff_entry["username"],
                    "name": staff_entry["name"],
                    "email": staff_entry["email"],
                    "role": staff_entry["role"],
                    "initial": staff_entry["initial"]
                }
            }).encode("utf-8"))
            return

        elif self.path == "/api/staff/delete":
            content_length = int(self.headers.get('Content-Length', 0))
            body = self.rfile.read(content_length).decode('utf-8')
            payload = json.loads(body)
            target_user = str(payload.get("username", "")).strip().lower()
            
            if target_user == "admin":
                self.send_response(400)
                self.send_header("Content-Type", "application/json")
                self.end_headers()
                self.wfile.write(json.dumps({"success": False, "error": "Cannot delete primary Administrator."}).encode("utf-8"))
                return

            users_path = os.path.join(DATA_DIR, "users_vault.json")
            users = []
            if os.path.exists(users_path):
                try:
                    with open(users_path, "r", encoding="utf-8") as f:
                        users = json.load(f)
                except:
                    pass
            
            orig_len = len(users)
            users = [u for u in users if u.get("username", "").lower() != target_user]
            deleted = len(users) < orig_len
            
            if deleted:
                try:
                    with open(users_path, "w", encoding="utf-8") as f:
                        json.dump(users, f, ensure_ascii=False, indent=2)
                except:
                    pass

            self.send_response(200)
            self.send_header("Content-Type", "application/json")
            self.end_headers()
            self.wfile.write(json.dumps({"success": deleted, "total_staff": len(users)}).encode("utf-8"))
            return

        elif self.path == "/api/tasks/add":
            content_length = int(self.headers.get('Content-Length', 0))
            body = self.rfile.read(content_length).decode('utf-8')
            payload = json.loads(body)
            
            tasks_path = os.path.join(DATA_DIR, "tasks_vault.json")
            tasks = []
            if os.path.exists(tasks_path):
                try:
                    with open(tasks_path, "r", encoding="utf-8") as f:
                        tasks = json.load(f)
                except:
                    pass
            
            import time
            new_task = {
                "id": payload.get("id") or f"TSK-{int(time.time()) % 10000}",
                "title": payload.get("title", "New Task").strip(),
                "client_name": payload.get("client_name", "").strip(),
                "phone": payload.get("phone", "").strip(),
                "type": payload.get("type", "Follow-up").strip(),
                "priority": payload.get("priority", "Normal").strip(),
                "due_date": payload.get("due_date", "").strip(),
                "status": payload.get("status", "Pending").strip(),
                "assigned_to": payload.get("assigned_to", "Unassigned").strip(),
                "notes": payload.get("notes", "").strip()
            }
            
            tasks.insert(0, new_task)
            try:
                with open(tasks_path, "w", encoding="utf-8") as f:
                    json.dump(tasks, f, ensure_ascii=False, indent=2)
            except:
                pass
                
            self.send_response(200)
            self.send_header("Content-Type", "application/json")
            self.end_headers()
            self.wfile.write(json.dumps({"success": True, "count": len(tasks), "task": new_task}).encode("utf-8"))
            return

        elif self.path == "/api/tasks/update":
            content_length = int(self.headers.get('Content-Length', 0))
            body = self.rfile.read(content_length).decode('utf-8')
            payload = json.loads(body)
            task_id = str(payload.get("id", "")).strip()
            
            tasks_path = os.path.join(DATA_DIR, "tasks_vault.json")
            tasks = []
            if os.path.exists(tasks_path):
                try:
                    with open(tasks_path, "r", encoding="utf-8") as f:
                        tasks = json.load(f)
                except:
                    pass
            
            updated = False
            for t in tasks:
                if str(t.get("id")) == task_id:
                    if "title" in payload:
                        t["title"] = str(payload.get("title", "")).strip()
                    if "assigned_to" in payload:
                        t["assigned_to"] = str(payload.get("assigned_to", "")).strip()
                    if "priority" in payload:
                        t["priority"] = str(payload.get("priority", "Normal")).strip()
                    if "client_name" in payload:
                        t["client_name"] = str(payload.get("client_name", "")).strip()
                    if "due_date" in payload:
                        t["due_date"] = str(payload.get("due_date", "")).strip()
                    if "notes" in payload:
                        t["notes"] = str(payload.get("notes", "")).strip()
                    if "status" in payload:
                        t["status"] = str(payload.get("status", t.get("status", "Pending"))).strip()
                    from datetime import datetime
                    t["updated_at"] = datetime.now().isoformat()
                    updated = True
                    break
                    
            if updated:
                try:
                    with open(tasks_path, "w", encoding="utf-8") as f:
                        json.dump(tasks, f, ensure_ascii=False, indent=2)
                except:
                    pass

            self.send_response(200)
            self.send_header("Content-Type", "application/json")
            self.end_headers()
            self.wfile.write(json.dumps({"success": updated}).encode("utf-8"))
            return

