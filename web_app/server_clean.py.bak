def resolve_gemini_tool_call(func_name, func_args):
    clients = []
    if os.path.exists(CLIENTS_VAULT_PATH):
        try:
            with open(CLIENTS_VAULT_PATH, "r", encoding="utf-8") as f:
                clients = json.load(f)
        except:
            clients = []

    if func_name == "search_crm_database":
        query = (func_args.get("query") or "").strip().lower()
        status_filter = (func_args.get("status") or "").strip().lower()
        
        matches = []
        for c in clients:
            c_name = str(c.get("name") or "").lower()
            c_phone = normalize_phone(c.get("phone") or "")
            c_status = str(c.get("status") or "").lower()
            
            # Check match
            name_match = query in c_name if query else True
            phone_match = (query.replace(" ", "") in c_phone) if (query and query.replace(" ", "").isdigit()) else False
            status_match = (status_filter in c_status) if status_filter else True
            
            if (name_match or phone_match) and status_match:
                matches.append({
                    "name": c.get("name"),
                    "phone": c.get("phone"),
                    "status": c.get("status", "New Lead"),
                    "last_contact": c.get("last_contact") or c.get("last_followup") or "Pending"
                })

        return {
            "search_query": query,
            "total_matches_found": len(matches),
            "matched_records": matches[:10]
        }

    elif func_name == "get_crm_vault_summary":
        total = len(clients)
        new_count = len([c for c in clients if "new" in str(c.get("status") or "").lower()])
        follow_count = len([c for c in clients if "follow" in str(c.get("status") or "").lower()])
        interested_count = len([c for c in clients if "interest" in str(c.get("status") or "").lower()])
        return {
            "total_contacts": total,
            "new_leads": new_count,
            "follow_up_due": follow_count,
            "interested": interested_count
        }

    elif func_name == "get_recent_clients":
        limit = int(func_args.get("limit") or 5)
        return {
            "recent_records": clients[:limit]
        }

    return {"error": f"Function {func_name} not recognized"}

SYSTEM_PROMPT = """You are Achyuta, a world-class executive AI business administrator and operational intelligence agent for enterprise CRM.

CRITICAL OPERATIONAL MANDATES:
1. STRICT ZERO EMOJIS POLICY: Never output any emojis under any circumstance. Maintain an ultra-professional, calm, executive demeanor.
2. TONE & INTELLECT: Speak with high executive clarity, authority, and structured precision. Be actionable, specific, and proactive.
3. MULTI-LINGUAL FLUENCY: Communicate naturally in English, Hindi, or conversational Hinglish matching the user's language and vibe.
4. DIRECT BUSINESS INTEGRATION & LIVE CAPABILITIES:
   - Client Vault: 819 enterprise contacts synchronized in real-time (794 New Leads, 24 Follow-up Due, 1 Interested). You can analyze leads, find clients, assess pipeline health, and suggest immediate outreach.
   - WhatsApp Outreach Engine: Prepare and draft personalized client communications, follow-up messages, and campaign queues.
   - Tasks & Operations Manager: Book callbacks, assign operational tasks to representatives (e.g. Rohit Sharma, Sachin Kain), prioritize schedules, and monitor deadlines.
   - Financial Ledger & Accounts: Track revenue, invoice clearances, pending receivables, and payment methods (UPI, Bank).
5. FORMATTING EXCELLENCE:
   - Format responses cleanly with bold section titles (**Title**), clear bullet points (- Item), and structured paragraphs.
   - Never output empty numbered lines like '1.' without text. Always pair numbers with bold headlines (e.g. '**1. Client Vault & Pipeline Management**').
   - When asked what you can do ('Kaya kar sakte ho'), do not give vague generic answers. Deliver an authoritative executive overview of the exact CRM operations, live stats (819 clients), and actionable sample commands the user can give you right now."""

class AchyutaWebHandler(SimpleHTTPRequestHandler):
    def do_GET(self):
        if self.path.startswith("/static/"):
            rel_path = self.path[8:].split('?')[0]
            static_file = os.path.join(DATA_DIR, "static", rel_path)
            if os.path.exists(static_file) and os.path.isfile(static_file):
                self.send_response(200)
                if static_file.endswith(".jpg") or static_file.endswith(".jpeg"):
                    self.send_header("Content-Type", "image/jpeg")
                elif static_file.endswith(".png"):
                    self.send_header("Content-Type", "image/png")
                elif static_file.endswith(".svg"):
                    self.send_header("Content-Type", "image/svg+xml")
                else:
                    self.send_header("Content-Type", "application/octet-stream")
                self.send_header("Cache-Control", "public, max-age=86400")
                self.end_headers()
                with open(static_file, "rb") as f:
                    self.wfile.write(f.read())
                return
            else:
                self.send_response(404)
                self.end_headers()
                return
        if self.path == "/" or self.path == "/index.html":
            self.send_response(200)
            self.send_header("Content-Type", "text/html; charset=utf-8")
            self.end_headers()
            with open(os.path.join(DATA_DIR, "index.html"), "rb") as f:
                self.wfile.write(f.read())
            return
        elif self.path == "/api/voice_agent/logs":
            logs = get_ai_call_logs_data()
            self.send_response(200)
            self.send_header("Content-Type", "application/json")
            self.end_headers()
            self.wfile.write(json.dumps({
                "success": True,
                "logs": logs,
                "total_calls": len(logs),
                "completed_calls": len([l for l in logs if l.get("call_status") == "Completed"])
            }).encode("utf-8"))
            return

        elif self.path == "/api/clients":
            self.send_response(200)
            self.send_header("Content-Type", "application/json")
            self.end_headers()
            clients = []
            if os.path.exists(CLIENTS_VAULT_PATH):
                try:
                    with open(CLIENTS_VAULT_PATH, "r", encoding="utf-8") as f:
                        clients = json.load(f)
                except:
                    pass
            self.wfile.write(json.dumps(clients).encode("utf-8"))
            return
        elif self.path == "/api/staff":
            self.send_response(200)
            self.send_header("Content-Type", "application/json")
            self.end_headers()
            users_path = os.path.join(DATA_DIR, "users_vault.json")
            users = []
            if os.path.exists(users_path):
                try:
                    with open(users_path, "r", encoding="utf-8") as f:
                        users = json.load(f)
                except:
                    pass
            # Don't expose passwords in staff list, include salary info
            sanitized = [{
                "username": u.get("username", ""),
                "email": u.get("email", ""),
                "name": u.get("name", ""),
                "role": u.get("role", "Staff Member"),
                "phone": u.get("phone", ""),
                "designation": u.get("designation", u.get("role", "Staff Member")),
                "monthly_salary": float(u.get("monthly_salary", 0)),
                "joining_date": u.get("joining_date", ""),
                "status": u.get("status", "Active"),
                "initial": u.get("initial", u.get("name", "U")[0].upper())
            } for u in users]
            self.wfile.write(json.dumps(sanitized).encode("utf-8"))
            return
        elif self.path == "/api/tasks":
            self.send_response(200)
            self.send_header("Content-Type", "application/json")
            self.end_headers()
            tasks_path = os.path.join(DATA_DIR, "tasks_vault.json")
            tasks = []
            if os.path.exists(tasks_path):
                try:
                    with open(tasks_path, "r", encoding="utf-8") as f:
                        tasks = json.load(f)
                except:
                    pass
            self.wfile.write(json.dumps(tasks).encode("utf-8"))
            return
        elif self.path == "/api/accounts":
            self.send_response(200)
            self.send_header("Content-Type", "application/json")
            self.end_headers()
            acc_path = os.path.join(DATA_DIR, "accounts_vault.json")
            txns = []
            if os.path.exists(acc_path):
                try:
                    with open(acc_path, "r", encoding="utf-8") as f:
                        txns = json.load(f)
                except:
                    pass
            self.wfile.write(json.dumps(txns).encode("utf-8"))
            return
        elif self.path == "/api/salary":
            self.send_response(200)
            self.send_header("Content-Type", "application/json")
            self.end_headers()
            sal_path = os.path.join(DATA_DIR, "salary_vault.json")
            salaries = []
            if os.path.exists(sal_path):
                try:
                    with open(sal_path, "r", encoding="utf-8") as f:
                        salaries = json.load(f)
                except:
                    pass
            self.wfile.write(json.dumps(salaries).encode("utf-8"))
            return
        elif self.path == "/api/attendance":
            self.send_response(200)
            self.send_header("Content-Type", "application/json")
            self.end_headers()
            fpath = os.path.join(DATA_DIR, "attendance_vault.json")
