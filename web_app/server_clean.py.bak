        elif self.path == "/api/contracts/sign":
            content_length = int(self.headers.get('Content-Length', 0))
            body = self.rfile.read(content_length).decode('utf-8')
            data = json.loads(body)
            fpath = os.path.join(DATA_DIR, "contracts_vault.json")
            items = []
            if os.path.exists(fpath):
                try:
                    with open(fpath, "r", encoding="utf-8") as f:
                        items = json.load(f)
                except:
                    pass
            for c in items:
                if str(c.get("id")) == str(data.get("id")):
                    c["status"] = "Signed"
                    c["signer_name"] = data.get("signer_name", "Authorized Signer")
                    import time as _time_mod
                    c["signed_date"] = _time_mod.strftime("%Y-%m-%d %I:%M %p")
                    c["signature_hash"] = "SHA256:" + str(int(_time_mod.time())) + "x9b"
            try:
                with open(fpath, "w", encoding="utf-8") as f:
                    json.dump(items, f, ensure_ascii=False, indent=2)
            except:
                pass
            self.send_response(200)
            self.send_header("Content-Type", "application/json")
            self.end_headers()
            self.wfile.write(json.dumps({"success": True}).encode("utf-8"))
            return

        elif self.path == "/api/chat":
            content_length = int(self.headers.get('Content-Length', 0))
            body = self.rfile.read(content_length).decode('utf-8')
            data = json.loads(body)
            prompt = data.get("prompt", "")
            history = data.get("history", [])

            # First, check if user requested a real CRUD operation
            executed, confirmation, action_meta = execute_agent_database_operation(prompt)
            if executed:
                self.send_response(200)
                self.send_header("Content-Type", "application/json")
                self.end_headers()
                self.wfile.write(json.dumps({
                    "reply": confirmation,
                    "action_executed": True,
                    "action_meta": action_meta
                }).encode("utf-8"))
                return

            url = f"https://generativelanguage.googleapis.com/v1beta/models/{AI_MODEL}:generateContent?key={AI_API_KEY}"
            contents = [{"role": "user", "parts": [{"text": SYSTEM_PROMPT}]}]
            for msg in history[-6:]:
                contents.append({"role": msg["role"], "parts": [{"text": msg["text"]}]})
            contents.append({"role": "user", "parts": [{"text": prompt}]})

            payload = {
                "contents": contents,
                "tools": GEMINI_CRM_TOOLS
            }
            req_data = json.dumps(payload).encode("utf-8")
            req = urllib.request.Request(url, data=req_data, headers={"Content-Type": "application/json"})

            try:
                with urllib.request.urlopen(req, timeout=25) as response:
                    res = json.loads(response.read().decode("utf-8"))
                    cand = res["candidates"][0]["content"]

                # Check if Gemini requested a function call against local CRM
                parts = cand.get("parts", [])
                func_calls = [p["functionCall"] for p in parts if "functionCall" in p]

                if func_calls:
                    # Model requested local CRM lookup
                    model_content = cand
                    f_call = func_calls[0]
                    f_name = f_call.get("name")
                    f_args = f_call.get("args", {})
                    
                    # Execute locally against clients_vault.json
                    tool_output = resolve_gemini_tool_call(f_name, f_args)

                    # Step 2: Feed tool output back to Gemini with candidate content
                    tool_round_contents = list(contents)
                    tool_round_contents.append(model_content)
                    tool_round_contents.append({
                        "role": "function",
                        "parts": [
                            {
                                "functionResponse": {
                                    "name": f_name,
                                    "response": tool_output
                                }
                            }
                        ]
                    })

                    round2_payload = {
                        "contents": tool_round_contents,
                        "tools": GEMINI_CRM_TOOLS
                    }
                    req2_data = json.dumps(round2_payload).encode("utf-8")
                    req2 = urllib.request.Request(url, data=req2_data, headers={"Content-Type": "application/json"})
                    
                    with urllib.request.urlopen(req2, timeout=25) as response2:
                        res2 = json.loads(response2.read().decode("utf-8"))
                        r2_parts = res2.get("candidates", [{}])[0].get("content", {}).get("parts", [])
                        reply = ""
                        for p in r2_parts:
                            if "text" in p:
                                reply = p["text"]
                                break
                        if not reply:
                            reply = "CRM database lookup completed."
                else:
                    reply = ""
                    for p in parts:
                        if "text" in p:
                            reply = p["text"]
                            break
                    if not reply:
                        reply = "Query acknowledged. Live database synchronized." 
            except urllib.error.HTTPError as e:
                err_text = ""
                try:
                    err_text = e.read().decode("utf-8")
                except: pass

                if e.code == 429 or "RESOURCE_EXHAUSTED" in err_text:
                    retry_time = "kuch der"
                    m = re.search(r'retry in\s+([0-9a-zA-Z\.\s]+)', err_text, re.IGNORECASE)
                    if m:
                        raw = m.group(1).strip().split('.')[0]
                        h_match = re.search(r'(\d+)\s*h', raw)
                        m_match = re.search(r'(\d+)\s*m', raw)
                        parts = []
                        if h_match: parts.append(f"{h_match.group(1)}h")
                        if m_match: parts.append(f"{m_match.group(1)}m")
                        if parts:
                            retry_time = " ".join(parts)
                        else:
                            retry_time = raw

                    self.send_response(200)
                    self.send_header("Content-Type", "application/json")
                    self.end_headers()
                    self.wfile.write(json.dumps({
                        "error_type": "quota_limit",
                        "retry_time": retry_time,
                        "reply": f"You've reached your usage limit. Resets in {retry_time}."
                    }).encode("utf-8"))
                    return
                else:
                    self.send_response(200)
                    self.send_header("Content-Type", "application/json")
                    self.end_headers()
                    self.wfile.write(json.dumps({
                        "error_type": "system_error",
                        "reply": "Unable to process request right now. Please try again shortly."
                    }).encode("utf-8"))
                    return

            except Exception as e:
                print(f"[CHAT EXCEPTION]: {type(e).__name__}: {e}")
                self.send_response(200)
                self.send_header("Content-Type", "application/json")
                self.end_headers()
                self.wfile.write(json.dumps({
                    "error_type": "system_error",
                    "reply": "Connection issue. Please verify network."
                }).encode("utf-8"))
                return

            self.send_response(200)
            self.send_header("Content-Type", "application/json")
            self.end_headers()
            self.wfile.write(json.dumps({"reply": reply}).encode("utf-8"))
            return

def start_server():
    server = ThreadingHTTPServer(('127.0.0.1', PORT), AchyutaWebHandler)
    print(f"Achyuta Web App running at http://localhost:{PORT}")
    server.serve_forever()

if __name__ == '__main__':
    start_server()
